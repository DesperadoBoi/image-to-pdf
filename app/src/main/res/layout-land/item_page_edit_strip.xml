<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/editor_land_page_item_width"
    android:layout_height="@dimen/editor_land_page_item_height"
    android:layout_marginBottom="@dimen/page_edit_strip_item_spacing"
    android:background="@drawable/bg_page_edit_strip_item"
    android:clickable="true"
    android:focusable="true"
    android:padding="@dimen/page_edit_strip_item_padding">

    <ImageView
        android:id="@+id/image_page_edit_strip_thumbnail"
        android:layout_width="@dimen/editor_land_page_item_thumbnail_size"
        android:layout_height="@dimen/editor_land_page_item_thumbnail_size"
        android:background="?attr/colorSurfaceVariant"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:src="@drawable/ic_broken_image_24" />

    <TextView
        android:id="@+id/text_page_edit_strip_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/editor_land_page_item_spacing"
        android:gravity="center_vertical|start"
        android:importantForAccessibility="no"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textAppearance="?attr/textAppearanceLabelSmall"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@id/image_page_edit_strip_thumbnail"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="2" />
</androidx.constraintlayout.widget.ConstraintLayout>
