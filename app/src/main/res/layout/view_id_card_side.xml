<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:screenReaderFocusable="true"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/standard_card_corner_radius"
    app:cardElevation="0dp"
    app:strokeColor="?attr/colorOutline"
    app:strokeWidth="@dimen/standard_outline_width">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/id_card_side_padding">

        <TextView
            android:id="@+id/text_id_card_side_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/text_id_card_side_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:accessibilityLiveRegion="polite"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.desperadoboi.imagetopdf.ui.idcard.IdCardPreviewLayout
            android:id="@+id/layout_id_card_preview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_spacing_small"
            android:background="@drawable/bg_id_card_preview">

            <ImageView
                android:id="@+id/image_id_card_preview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/image_id_card_placeholder"
                android:layout_width="88dp"
                android:layout_height="64dp"
                android:layout_gravity="center"
                android:alpha="0.72"
                android:contentDescription="@null"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_tool_id_scan_safe" />

            <ProgressBar
                android:id="@+id/progress_id_card_side"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:visibility="gone" />

            <TextView
                android:id="@+id/text_id_card_side_error"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:padding="16dp"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?attr/colorOnSurface"
                android:visibility="gone"
                tools:visibility="visible" />

        </com.desperadoboi.imagetopdf.ui.idcard.IdCardPreviewLayout>

        <com.desperadoboi.imagetopdf.ui.idcard.ResponsiveActionRow
            android:id="@+id/layout_id_card_empty_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_spacing_small"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_id_card_camera"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="2"
                android:minHeight="@dimen/touch_target"
                android:text="@string/id_card_action_take_photo"
                app:icon="@drawable/ic_source_camera_24" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/button_id_card_gallery"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:breakStrategy="simple"
                android:hyphenationFrequency="none"
                android:maxLines="2"
                android:minHeight="@dimen/touch_target"
                android:text="@string/id_card_action_choose_image"
                app:icon="@drawable/ic_source_gallery_24" />

        </com.desperadoboi.imagetopdf.ui.idcard.ResponsiveActionRow>

        <LinearLayout
            android:id="@+id/layout_id_card_ready_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/content_spacing_small"
            android:orientation="vertical"
            android:visibility="gone">

            <com.desperadoboi.imagetopdf.ui.idcard.ResponsiveActionRow
                android:id="@+id/layout_id_card_ready_source_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_id_card_replace"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="2"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/id_card_action_replace" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_id_card_retake"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="2"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/id_card_action_retake" />

            </com.desperadoboi.imagetopdf.ui.idcard.ResponsiveActionRow>

            <com.desperadoboi.imagetopdf.ui.idcard.ResponsiveActionRow
                android:id="@+id/layout_id_card_ready_edit_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_id_card_rotate"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="2"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/id_card_action_rotate" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_id_card_correct"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1.4"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="2"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/id_card_action_correct" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/button_id_card_delete"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:breakStrategy="simple"
                    android:hyphenationFrequency="none"
                    android:maxLines="2"
                    android:minHeight="@dimen/touch_target"
                    android:text="@string/id_card_action_delete"
                    android:textColor="@color/destructive_icon" />

            </com.desperadoboi.imagetopdf.ui.idcard.ResponsiveActionRow>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
